{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr *)",
      "Bash(gh run *)"
    ],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(vercel --prod*)",
      "Edit(src/lib/tokens.generated.ts)",
      "Edit(src/app/tokens.css)",
      "Edit(tests/visual/__screenshots__/**)",
      "Read(**/.github-token)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node scripts/agent-hooks/post-edit.mjs", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/agent-hooks/stop.mjs", "timeout": 120 }
        ]
      }
    ]
  }
}
